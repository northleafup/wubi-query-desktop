{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$RESOURCE/assets/images/char/*.gif" },
        { "path": "$RESOURCE/../assets/images/char/*.gif" },
        { "path": "$RESOURCE/../assets/data/*.tsv" },
        { "path": "assets/images/char/*.gif" },
        { "path": "assets/data/*.tsv" }
      ]
    },
    "fs:default"
  ]
}
