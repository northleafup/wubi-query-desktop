{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$RESOURCE/resources/images/char/*.gif" },
        { "path": "$RESOURCE/../resources/images/char/*.gif" },
        { "path": "$RESOURCE/../resources/data/*.tsv" },
        { "path": "resources/images/char/*.gif" },
        { "path": "resources/data/*.tsv" }
      ]
    },
    "fs:default",
    "global-shortcut:default"
  ]
}
